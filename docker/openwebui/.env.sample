OPENWEBUI_PORT=3000

# Admin account — seeded on first run only (no effect if an admin already exists)
OPENWEBUI_ADMIN_NAME=Admin
OPENWEBUI_ADMIN_EMAIL=
OPENWEBUI_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Keycloak SSO (OAuth2/OIDC) — remove or leave empty to disable
# ---------------------------------------------------------------------------

# Allow new users to register via SSO (set to true when Keycloak is configured)
OPENWEBUI_ENABLE_OAUTH_SIGNUP=false

# Keycloak client of OpenWebUI: defaults to the open-webui client of the realm template. The secret is written into
# the realm by configure_keycloak.sh; on an existing realm, copy it from Clients → open-webui → Credentials.
#OPENWEBUI_OAUTH_CLIENT_ID=open-webui
OPENWEBUI_KEYCLOAK_CLIENT_SECRET=*********************************

# OIDC discovery document URL: defaults to the public Keycloak issuer built from KEYCLOAK_* in docker/.env,
#   <scheme>://<keycloak-host>:<port>/realms/<realm-name>/.well-known/openid-configuration
# Set it only when the realm lives on another Keycloak instance.
#OPENWEBUI_OPENID_PROVIDER_URL=

# Label shown on the SSO login button (defaults to "SSO" if unset)
OPENWEBUI_OAUTH_PROVIDER_NAME=

# OAuth callback URL: defaults to ${OPENWEBUI_URL}/oauth/oidc/callback (docker/.env), which the realm template
# registers as a redirect URI of the open-webui client
#OPENWEBUI_OPENID_REDIRECT_URI=

# Key encrypting the OAuth tokens kept in the server-side sessions (OpenWebUI >= 0.13); generate it with
#   openssl rand -hex 32
# Changing it invalidates the current SSO sessions (users sign in again).
OPENWEBUI_OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=
