OPENWEBUI_PORT=3000

# Admin account — seeded on first run only (no effect if an admin already exists)
OPENWEBUI_ADMIN_NAME=Admin
OPENWEBUI_ADMIN_EMAIL=
OPENWEBUI_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Keycloak SSO (OAuth2/OIDC) — remove or leave empty to disable
# ---------------------------------------------------------------------------

# Allow new users to register via SSO (set to true when Keycloak is configured)
OPENWEBUI_ENABLE_OAUTH_SIGNUP=false

# Client ID and secret created in the Keycloak realm for OpenWebUI
OPENWEBUI_OAUTH_CLIENT_ID=
OPENWEBUI_OAUTH_CLIENT_SECRET=

# OIDC discovery document URL for your realm
# Use the internal Docker hostname when OpenWebUI and Keycloak share the same network:
#   http://keycloak:8080/realms/<realm-name>/.well-known/openid-configuration
# Use the public hostname when Keycloak is external or TLS is terminated at the reverse proxy:
#   https://<keycloak-host>/realms/<realm-name>/.well-known/openid-configuration
OPENWEBUI_OPENID_PROVIDER_URL=

# Label shown on the SSO login button (defaults to "SSO" if unset)
OPENWEBUI_OAUTH_PROVIDER_NAME=

# OAuth callback URL — must match the redirect URI registered in the Keycloak client
# Format: https://<openwebui-public-host>/oauth/oidc/callback
OPENWEBUI_OPENID_REDIRECT_URI=
