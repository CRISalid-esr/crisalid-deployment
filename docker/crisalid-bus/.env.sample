CRISALID_BUS_DEFINITIONS_FILE=/etc/rabbitmq/definitions.json
CRISALID_BUS_HTTP_PORT=15672

# Host interface for RabbitMQ management console (defaults to DEFAULT_ADMIN_BIND_ADDR of docker/.env)
#CRISALID_BUS_BIND_ADDR=127.0.0.1
# Host interface for AMQP 5672, when another host connects to the bus (defaults to DEFAULT_ADMIN_BIND_ADDR);
# also uncomment the AMQP line in crisalid-bus.yaml
#CRISALID_BUS_AMQP_BIND_ADDR=127.0.0.1
