# used both in the Neo4j yaml file and in the offline backup script
NEO4J_VERSION=2026.06.0
NEO4J_EDITION=community
# Full image reference used as-is by the backup/restore scripts (include edition and base OS)
NEO4J_ADMIN_IMAGE=neo4j/neo4j-admin:2026.06.0-community-debian

NEO4J_HTTP_PORT=7474

NEO4J_HEAP_INITIAL=4G
NEO4J_HEAP_MAX=8G
NEO4J_PAGECACHE_SIZE=6G

# Host interface for Neo4j HTTP and Bolt (defaults to DEFAULT_ADMIN_BIND_ADDR of docker/.env)
#NEO4J_BIND_ADDR=127.0.0.1
