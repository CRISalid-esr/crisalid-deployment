KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# KEYCLOAK_HTTP_ENABLED must be true when KEYCLOAK_PROXY_HEADERS is set (proxy terminates TLS, Keycloak listens on HTTP)
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_HOSTNAME_STRICT_HTTPS=false
# Proxy header mode: xforwarded (default, most reverse proxies) or forwarded (RFC 7239)
# Requires KEYCLOAK_HTTP_ENABLED=true
#KEYCLOAK_PROXY_HEADERS=xforwarded
