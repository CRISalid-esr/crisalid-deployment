# LLM model identifier (e.g. mistral, llama3, etc.)
CRISALID_AGENTS_MODEL=

# API key for the LLM provider
CRISALID_AGENTS_API_KEY=

# Base URL of the LLM API (e.g. https://api.openai.com/v1 or local Ollama endpoint)
CRISALID_AGENTS_LLM_API_BASE=

# Internal URL of the neo4j-mcp toolbox service
CRISALID_MCP_TOOLBOX_URL=http://neo4j-mcp:5000

# MCP toolset identifier exposed by the toolbox
CRISALID_MCP_TOOLBOX_TOOLSET=

# Agents served by the pipelines server and the chat API (comma-separated names under agents/ in crisalid-agents)
CRISALID_AGENTS_AGENTS=generic_agent

# Keycloak client credentials for MCP toolbox authentication
CRISALID_AGENTS_KEYCLOAK_CLIENT_ID=
CRISALID_AGENTS_KEYCLOAK_CLIENT_SECRET=
# Set to "false" only if the internal Keycloak endpoint uses a self-signed certificate
CRISALID_AGENTS_KEYCLOAK_SSL_VERIFY=true

# Horizon Europe topic index (OpenSearch service of the horizon_europe_index profile, see horizon-europe-index/)
HORIZON_OS_URL=https://opensearch:9200
HORIZON_OS_USER=admin
# Same value as OPENSEARCH_ADMIN_PASSWORD in horizon-europe-index/.env
HORIZON_OS_PASSWORD=
HORIZON_OS_INDEX=horizon-topics
HORIZON_SEARCH_PIPELINE=horizon-hybrid-rrf
