# LLM model identifier (e.g. mistral, llama3, etc.)
CRISALID_AGENTS_MODEL=

# API key for the LLM provider
CRISALID_AGENTS_API_KEY=

# Base URL of the LLM API (e.g. https://api.openai.com/v1 or local Ollama endpoint)
CRISALID_AGENTS_LLM_API_BASE=

# Internal URL of the neo4j-mcp toolbox service
CRISALID_MCP_TOOLBOX_URL=http://neo4j-mcp:5000

# MCP toolset identifier exposed by the toolbox
CRISALID_MCP_TOOLBOX_TOOLSET=

# Agents served by the pipelines server (OpenWebUI), comma-separated package names under agents/ in crisalid-agents.
# The Horizon topic finder (project_topic_matching) needs the horizon_europe_index profile up and indexed. SorboBot
# (sorbobot) needs the crisalid-taxi profile, documents classified by taxi (TAXI_ENABLED=true in docker/ikg/.env) and
# a neo4j-mcp image shipping the "sorbobot" toolset.
CRISALID_AGENTS_AGENTS=generic_agent,project_topic_matching,sorbobot

# Agents served by the chat API (SoVisuPlus picks one with SVP_CRISALID_AGENTS_AGENT). Own list: SorboBot is only
# served to OpenWebUI.
CRISALID_AGENTS_CHAT_API_AGENTS=generic_agent,project_topic_matching

# Keycloak client credentials for MCP toolbox authentication
CRISALID_AGENTS_KEYCLOAK_CLIENT_ID=
CRISALID_AGENTS_KEYCLOAK_CLIENT_SECRET=
# Set to "false" only if the internal Keycloak endpoint uses a self-signed certificate
CRISALID_AGENTS_KEYCLOAK_SSL_VERIFY=true

# Horizon Europe topic index (OpenSearch service of the horizon_europe_index profile, see horizon-europe-index/):
# used by both agent services (Horizon topic finder) and by the crisalid-agents-batch service (index ingestion,
# Topic-to-Researcher Match). Internal HTTP without authentication.
HORIZON_OS_URL=http://opensearch:9200
HORIZON_OS_INDEX=horizon-topics
HORIZON_SEARCH_PIPELINE=horizon-hybrid-rrf

# Topic-to-Researcher Match batch (crisalid-agents-batch service): dedicated model, defaults to CRISALID_AGENTS_MODEL
TRM_MODEL=

# SorboBot (research expertise agent, pipelines server only): internal URL of the crisalid-taxi service
CRISALID_TAXI_URL=http://crisalid-taxi:8000
# Tuning, every value shows the agent's built-in default (leave commented out to keep it).
# Timeouts (seconds) of the taxi, toolbox and LLM judge calls
#SORBOBOT_TAXI_TIMEOUT_SECONDS=15
#SORBOBOT_TOOLBOX_TIMEOUT_SECONDS=30
#SORBOBOT_JUDGE_TIMEOUT_SECONDS=30
# Taxi request: topics asked, minimum length of the text sent, minimum text-to-topic similarity
#SORBOBOT_TAXI_MAX_TOPICS=100
#SORBOBOT_TAXI_MIN_QUERY_CHARS=25
#SORBOBOT_SEMANTIC_THRESHOLD=0.56
# Topics kept from taxi, minimum publication-to-topic similarity, HAS_TOPIC link sources kept (empty: every source)
#SORBOBOT_MAX_SEARCH_TOPICS=20
#SORBOBOT_TOPIC_LINK_THRESHOLD=0.57
#SORBOBOT_TOPIC_SOURCES=crisalid
# LLM judges: minimum score (0 disables both judges); sibling widening when too few researchers are found
#SORBOBOT_JUDGE_THRESHOLD=0.6
#SORBOBOT_MIN_AUTHORS=2
#SORBOBOT_MAX_JUDGED_SIBLINGS=100
# Ranking of the researchers: weighted_relevance or count
#SORBOBOT_RANKING_METHOD=weighted_relevance
# Result sizes
#SORBOBOT_SHOW_MAX_AUTHORS=10
#SORBOBOT_SHOW_MAX_DOMAINS=5
#SORBOBOT_SHOW_MAX_PERSON_PUBLICATIONS=20
#SORBOBOT_PROFILE_MAX_PUBLICATIONS=20
#SORBOBOT_EXPLORE_MAX_DOMAINS=10
# Maximum length of a user message
#SORBOBOT_MAX_MESSAGE_CHARS=1000
# Answer languages (each needs a message catalogue in the agent) and the fallback language
#SORBOBOT_SUPPORTED_LANGUAGES=en,fr
#SORBOBOT_DEFAULT_LANGUAGE=en
