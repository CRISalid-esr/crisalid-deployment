# OpenSearch service for the Horizon Europe topic index (profile: horizon_europe_index)
# The admin password OPENSEARCH_ADMIN_PASSWORD is shared with crisalid-agents: set it in docker/.env
# Set to true only for local development without TLS/auth (then OPENSEARCH_HEALTH_URL=http://localhost:9200/_cluster/health)
OPENSEARCH_DISABLE_SECURITY=false
OPENSEARCH_HEALTH_URL=https://localhost:9200/_cluster/health
OPENSEARCH_HEAP=1g
