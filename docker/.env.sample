INSTITUTION_NAME="University of Example"

APOLLO_HOST=apollo
APOLLO_API_PORT=4000
APOLLO_ENABLE_API_KEYS="true"
SOVISUPLUS_GRAPHQL_API_KEY="*******************"

GRAPHQL_ENDPOINT_ENABLED="true"

CRISALID_BUS_HOST=crisalid-bus
CRISALID_BUS_USER=crisalid_bus_user
CRISALID_BUS_PASSWORD=xxxxxxxxxxxxxxxxx
CRISALID_BUS_AMQP_PORT=5672

LDAP_HOST=ldaps://my-ldap-host
LDAP_BIND_DN='cn=my-user,ou=admin,dc=my-univ,dc=fr'
LDAP_BIND_PASSWORD='my-password'
# Set to True to override LDAP structure data with the structures spreadsheet (default False)
OVERRIDE_LDAP_STRUCTURE_DATA_FROM_SPREADSHEET=False

# Public Keycloak URL: the single issuer of the stack, used by the browsers and by the containers alike
KEYCLOAK_SCHEME=http
KEYCLOAK_PORT=8080
KEYCLOAK_HOST=keycloak.local
KEYCLOAK_REALM=crisalid-inst
# Issuer of the realm, exactly as Keycloak writes it in the tokens (iss claim): the chat API and the toolbox compare
# it character for character. Defaults to ${KEYCLOAK_SCHEME}://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}/realms/${KEYCLOAK_REALM}.
# Keycloak omits the default port of the scheme, so set it explicitly, without the port, when KEYCLOAK_PORT is 443
# or 80 (reverse proxy): https://keycloak.example.org/realms/crisalid-inst
#KEYCLOAK_ISSUER=
# Network alias and container hostname of the Keycloak service (keycloak / keycloak-tls profiles), so that
# KEYCLOAK_HOST resolves to it from the other containers. Defaults to KEYCLOAK_HOST, which is right when Keycloak itself answers on
# KEYCLOAK_PORT (local HTTP or local TLS with mkcert). When TLS ends at a reverse proxy in front of Keycloak, the
# containers must reach the proxy instead: set a harmless value here (e.g. keycloak.internal) and make sure
# KEYCLOAK_HOST resolves through public DNS or extra_hosts.
#KEYCLOAK_NETWORK_ALIAS=

ORCID_URL=https://sandbox.orcid.org
ORCID_SCOPES="/person/update"
ORCID_CLIENT_ID=APP-xxxxxxxxxxxxxxxxxx
ORCID_CLIENT_SECRET=xxxxxxxxxxxxxxxxxx

NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j # Neo4j only accepts "neo4j" as admin username
NEO4J_PASSWORD=strong-password

# Public URLs of the applications signing users in with Keycloak (redirect URIs and web origins of their clients in
# the realm template). The secret of each Keycloak client lives in the env file of its service:
#   sovisuplus/.env        SOVISUPLUS_KEYCLOAK_CLIENT_SECRET
#   openwebui/.env         OPENWEBUI_KEYCLOAK_CLIENT_SECRET
#   crisalid-agents/.env   CRISALID_AGENTS_KEYCLOAK_CLIENT_SECRET
# configure_keycloak.sh reads those files to render the realm template.
SOVISUPLUS_URL=http://sovisuplus.local:3000 # public URL (scheme + host + port if not 80/443)
# OpenWebUI public URL (OAuth callback ${OPENWEBUI_URL}/oauth/oidc/callback, web origin)
OPENWEBUI_URL=http://localhost:3000

# Git ref (tag or branch) of the crisalid-directory-bridge repository whose DAGs are cloned
# by configure_cdb.sh prod. Use the CDB release tag matching this deployment release.
# Ignored in dev, where configure_cdb.sh always clones dev-main.
# See https://github.com/CRISalid-esr/crisalid-directory-bridge/releases
CDB_DAGS_REF=v1.2.0

# --EMBEDDINGS-- (shared by ikg, crisalid-agents and crisalid-taxi)
# URL of the OpenAI-compatible embeddings endpoint (e.g. vLLM, TEI, OpenAI).
EMBEDDING_API_URL=
# API key for the embedding endpoint. Leave empty if the endpoint requires no authentication.
EMBEDDING_API_KEY=
# Model name to pass in the API request body. Must match the model loaded by the embedding server.
EMBEDDING_API_MODEL=
# Timeout in seconds for each embedding API request.
EMBEDDING_TIMEOUT_SECONDS=30

CDB_POSTGRES_HOST=cdb-postgres
CDB_POSTGRES_PORT=5432
CDB_POSTGRES_DB=airflow
CDB_POSTGRES_USER=airflow
CDB_POSTGRES_PASSWORD=airflow

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<password>

