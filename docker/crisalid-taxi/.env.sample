# Embedding endpoint vars (EMBEDDING_API_URL, EMBEDDING_API_KEY, EMBEDDING_API_MODEL,
# EMBEDDING_TIMEOUT_SECONDS) are defined in the shared docker/.env

# Host path of the OpenAlex snapshot (topics/domains/fields/subfields).
# Populate the default location with: scripts/download_openalex_tree.sh crisalid-taxi
#TAXI_OPENALEX_DATA_HOST_PATH=./data/openalex

# Number of texts sent per request to the embedding API
TAXI_EMBEDDING_BATCH_SIZE=32

# Matching defaults (each can be overridden per request)
# Minimum cosine similarity a concept must reach to be returned
TAXI_SIMILARITY_THRESHOLD=0.53
# Maximum concepts returned per input text, among those above the threshold
TAXI_MAX_TOPICS=100
# Minimum characters an input text must have to be matched
TAXI_MIN_INPUT_LENGTH=25

# Retries against the embedding API
TAXI_RETRY_MAX_ATTEMPTS=3
TAXI_RETRY_MIN_WAIT=2
TAXI_RETRY_MAX_WAIT=10

# Internal OpenSearch instance (vector store)
TAXI_OPENSEARCH_CLUSTER_NAME=crisalid-taxi
TAXI_OPENSEARCH_NODE_NAME=crisalid-taxi-node
TAXI_OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
TAXI_OPENSEARCH_INITIAL_ADMIN_PASSWORD=<change-me>

# Host port of the optional OpenSearch Dashboards UI (profile crisalid-taxi-dashboards)
TAXI_DASHBOARDS_PORT=5601
