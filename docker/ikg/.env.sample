HARVESTERS=["idref", "scanr", "hal", "openalex", "scopus"]

# Do we want to refresh the org registry at startup?
# It's a very long process, that needs to be done periodically, but not necessarily at every startup.
# IKG container startup will wait for the org registry to be ready before starting.
REFRESH_ORG_REGISTRY=true

# --EMBEDDINGS--
# Embedding computation is disabled by default. Set to true to enable it.
# Only the openai_compatible provider is supported in Docker deployments (remote HTTP endpoint).
# The Embeddable label is always applied to eligible nodes regardless of this flag,
# so embeddings can be computed later with the CLI without rebuilding the graph.
EMBEDDING_ENABLED=false

# URL of the OpenAI-compatible embeddings endpoint (e.g. vLLM, TEI, OpenAI).
# Required when EMBEDDING_ENABLED=true.
EMBEDDING_API_URL=

# API key for the embedding endpoint. Leave empty if the endpoint requires no authentication.
EMBEDDING_API_KEY=

# Model name to pass in the API request body.
# Must match the model loaded by the embedding server.
EMBEDDING_API_MODEL=

# Output dimension of the embedding model.
# Must match the model's actual output size; used to configure the Neo4j vector index.
# Common values: 384 (e.g. multilingual-e5-small), 768 (e.g. e5-base), 1536 (OpenAI ada-002).
EMBEDDING_DIMENSIONS=384

# Number of texts sent per request to the embedding API.
# Must not exceed the server's max-client-batch-size.
EMBEDDING_BATCH_SIZE=32

# Timeout in seconds for each embedding API request.
EMBEDDING_TIMEOUT_SECONDS=30